# Variables for the local Cloudflare Workers preview (`npm run cf:preview`)
# and for `next dev` with DATABASE_DRIVER=d1. Copy to `.dev.vars` (gitignored).
# In production these values are Worker secrets/variables – never commit them.
NEXTJS_ENV=production
AUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:8787
# Dev outbox (admin-only /dev/outbox) – records mail/SMS instead of sending.
ENABLE_DEV_OUTBOX=true
# Optional: only record these recipients (e.g. me@example.com,@my-domain.de)
DEV_OUTBOX_RECIPIENTS=
# Stripe sandbox only. Use the local/test values outside the repository.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_YEARLY=
# RESEND_API_KEY=
# EMAIL_FROM=
# Optional dedicated sender for verification-code mail (falls back to EMAIL_FROM):
# EMAIL_FROM_VERIFICATION=
