/**
 * Cloudflare Workers configuration for INNER CIRCLE (OpenNext adapter).
 *
 * The Next.js app is built with `npm run cf:build` (`opennextjs-cloudflare build`),
 * which produces the Worker entry (`.open-next/worker.js`) and the static assets
 * directory (`.open-next/assets`) referenced below. Both paths are generated –
 * never edit them by hand. See docs/09-deployment.md for the full runbook.
 *
 * Reference: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inner-circle",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    // Node.js APIs (node:crypto for scrypt password hashing, node:util, …)
    "nodejs_compat",
    // Only public URLs may be fetched from the Worker (Resend, Twilio, Stripe)
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Logs + traces in the Cloudflare dashboard (Workers → inner-circle → Observability)
  "observability": {
    "enabled": true
  },
  // Non-secret runtime variables. Secrets (AUTH_SECRET, STRIPE_SECRET_KEY, …)
  // are never stored here – set them with `wrangler secret put` or in the
  // dashboard (Settings → Variables and Secrets). Public values such as
  // NEXT_PUBLIC_SITE_URL can be added here or in the dashboard as plain text.
  "vars": {
    "NEXTJS_ENV": "production"
  },
  // Keep plain-text variables that were added in the dashboard
  // (NEXT_PUBLIC_SITE_URL, EMAIL_FROM, ENABLE_DEV_OUTBOX, DEV_OUTBOX_RECIPIENTS, …).
  // Without this flag every `wrangler deploy` (also Workers Builds) treats the
  // `vars` block above as the complete list and DELETES dashboard variables.
  "keep_vars": true,
  /**
   * D1 database (SQLite at the edge). The application accesses it through the
   * `DB` binding – keep that name. No `database_id` is required: Wrangler's
   * resource provisioning looks the database up by `database_name` and creates
   * it on the first `wrangler deploy` if it does not exist yet (you may also
   * create it up front with `npm run cf:d1:create`). Schema migrations live in
   * ./drizzle and are applied with `wrangler d1 migrations apply DB --remote`
   * (part of `npm run cf:release`). See docs/09-deployment.md.
   */
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inner-circle-db",
      "migrations_dir": "drizzle"
    }
  ],
  /**
   * Media storage for member uploads (profile photos, Sprint 13). Images are
   * stored as objects under `avatars/<userId>/…` – never as Base64 in D1.
   * Wrangler resource provisioning creates the bucket on the first deploy if
   * it does not exist yet (like the D1 database above); locally the binding is
   * emulated by Wrangler (`next dev` / `cf:preview`), so no cloud account is
   * needed for development. Public serving works out of the box via the app
   * route `/api/media/<key>`; optionally set `R2_PUBLIC_BASE_URL` to a public
   * bucket domain (r2.dev / custom domain) to offload image requests from the
   * Worker – see docs/09-deployment.md §"Bildspeicher (R2)".
   */
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "inner-circle-media"
    }
  ]
  /**
   * Optional: on-the-fly image optimisation for next/image via Cloudflare Images.
   * Without this binding images are served unoptimised (the site's images are
   * static files in /public, so this is fine to start with).
   *
   * "images": { "binding": "IMAGES" },
   */
}
