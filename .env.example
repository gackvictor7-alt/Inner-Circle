# INNER CIRCLE – environment variables for local Node.js development
# (`npm run dev`, `npm test`, scripts). Copy to `.env` and fill in real values.
# Never commit `.env`. Production values live as Cloudflare Worker secrets
# (see docs/09-deployment.md); the Workers preview uses `.dev.vars` instead.

# --- Core -------------------------------------------------------------------
# Signs sessions, tokens and verification codes. Generate: openssl rand -base64 48
AUTH_SECRET=
# Public origin of the site (links in e-mails, Stripe return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Node.js uses libSQL. Local file (default) or a hosted libSQL/Turso URL.
DATABASE_URL=file:./dev.db
DATABASE_AUTH_TOKEN=
# Force a driver: "libsql" (Node) or "d1" (Cloudflare binding, e.g. `DATABASE_DRIVER=d1 npm run dev`)
DATABASE_DRIVER=
# Log SQL statements ("true")
DB_LOG=

# --- E-mail (Resend) – without a key messages go to the dev outbox ---------
RESEND_API_KEY=
EMAIL_FROM="INNER CIRCLE <noreply@example.com>"

# --- SMS (Twilio) – optional ----------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TEST_MODE=

# --- Payments (Stripe, test mode first) -----------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_RETURN_URL=
# Live keys are refused unless explicitly allowed
ALLOW_STRIPE_LIVE=false

# --- Social login – optional ------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- File storage (S3-compatible, e.g. Cloudflare R2) – optional ------------
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Development switches ---------------------------------------------------
# Record outgoing mail/SMS in the dev outbox (/dev/outbox, admins only) instead
# of sending them. Local development enables this automatically while no mail
# provider exists; a deployed Worker only with an explicit "true" (test phase
# only – remove before launch, see docs/09-deployment.md).
ENABLE_DEV_OUTBOX=true
# Optional allow-list for the dev outbox: only these recipients are recorded
# (comma-separated e-mails/phone numbers, or whole domains as "@example.com").
DEV_OUTBOX_RECIPIENTS=
# Allow activating memberships without Stripe (dev/demo only – never in production)
ALLOW_DEV_MEMBERSHIP_ACTIVATION=false
# Connection requests allowed during the 48 h discovery trial
TRIAL_CONNECTION_LIMIT=3
# Password for seeded demo accounts (`npm run db:seed`)
SEED_DEMO_PASSWORD=
